---
const { metadata } = Astro.props;
const { links, tags } = metadata;

const base = 'https://blog.chrjl.dev/tags';
---

<footer class="border-t-1">
  {
    tags ? (
      <p class="flex flex-row items-baseline">
        <span class="mb-1 block w-12">Tags:</span>
        <span class="text-sm flex flex-row flex-wrap gap-x-2">
          {tags.map((tag: string) => (
            <a href={base + '/' + tag}>#{tag}</a>
          ))}
        </span>
      </p>
    ) : null
  }
  {
    links ? (
      <p>
        <span class="mb-1 block">See also:</span>
        {links?.map((url: string) => (
          <span class="flex flex-row items-center gap-x-4 pl-4 text-sm">
            <img
              src={`https://icons.duckduckgo.com/ip2/${new URL(url).hostname}.ico`}
              width="100%"
              height="100%"
              class="mt-0 mb-0 w-4 h-4"
            />
            <a target="_blank" href={url}>
              {url}
            </a>
          </span>
        ))}
      </p>
    ) : null
  }
</footer>
